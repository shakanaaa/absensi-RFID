{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "Absensi Terminal",
    "version": "0.1.0",
    "identifier": "id.absensi.terminal",
    "build": {
        "beforeDevCommand": "npm run dev",
        "beforeBuildCommand": "npm run build",
        "devUrl": "http://localhost:1420",
        "frontendDist": "../dist"
    },
    "app": {
        "windows": [
            {
                "title": "Terminal Absensi RFID",
                "width": 1024,
                "height": 768,
                "resizable": true
            }
        ],
        "security": {
            "csp": "default-src 'self'; connect-src 'self' http://localhost:* http://127.0.0.1:* https:; img-src 'self' data:"
        }
    },
    "bundle": {
        "active": true,
        "targets": "all",
        "icon": []
    }
}
